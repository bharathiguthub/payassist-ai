# PayAssist AI - local development settings.
# Copy to .env (git-ignored) or run:  .\scripts\new-dev-env.ps1   (generates random secrets)
# These are LOCAL DEVELOPMENT values only. Production secrets come from a secrets manager
# (e.g. AWS Secrets Manager) and are never stored in files.

# --- PostgreSQL ---
POSTGRES_DB=payassist
# Host port for connecting from Windows (pgAdmin, host-run backend). 5433 avoids a local PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
POSTGRES_USER=payassist
POSTGRES_PASSWORD=change-me
# Password of the restricted runtime role payassist_app: the backend's own login (ADR 0013). POSTGRES_USER is the
# schema owner and is only used by the one-off "migrate" job.
PAYASSIST_DB_APP_PASSWORD=change-me-app-password

# --- Keycloak ---
KEYCLOAK_ADMIN_USERNAME=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Shared secret between Keycloak and the BFF confidential client.
KEYCLOAK_CLIENT_SECRET=change-me
# Password for the five synthetic demo users (agent.alice, sam.supervisor, tara.supervisor, ada.admin, nora.norole).
# Realm policy: at least 12 characters and not equal to the username.
PAYASSIST_DEMO_PASSWORD=change-me-12chars
