{
  "realm": "payassist",
  "displayName": "PayAssist AI",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      { "name": "CARE_AGENT", "description": "Customer care executive: search and investigate payments" },
      { "name": "CARE_SUPERVISOR", "description": "Care team supervisor: agent capabilities plus team statistics" },
      { "name": "ADMIN", "description": "Platform administrator: all capabilities plus audit log" }
    ]
  },
  "clients": [
    {
      "clientId": "payassist-bff",
      "name": "PayAssist BFF",
      "description": "Confidential client used by the Spring Boot Backend-for-Frontend. The browser never receives its tokens.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/##http://localhost:5173/"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "agent.alice",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Agent",
      "email": "agent.alice@example.com",
      "credentials": [{ "type": "password", "value": "${PAYASSIST_DEMO_PASSWORD}", "temporary": false }],
      "realmRoles": ["CARE_AGENT"]
    },
    {
      "username": "sam.supervisor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Supervisor",
      "email": "sam.supervisor@example.com",
      "credentials": [{ "type": "password", "value": "${PAYASSIST_DEMO_PASSWORD}", "temporary": false }],
      "realmRoles": ["CARE_SUPERVISOR"]
    },
    {
      "username": "ada.admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "email": "ada.admin@example.com",
      "credentials": [{ "type": "password", "value": "${PAYASSIST_DEMO_PASSWORD}", "temporary": false }],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "nora.norole",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Nora",
      "lastName": "Norole",
      "email": "nora.norole@example.com",
      "credentials": [{ "type": "password", "value": "${PAYASSIST_DEMO_PASSWORD}", "temporary": false }],
      "realmRoles": []
    }
  ]
}
